{
  "all": true,
  "src": ["src"],
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    ".coverage-ts-runtime/**"
  ],
  "exclude": ["**/*.d.ts"],
  "exclude-after-remap": true,
  "extension": [".ts", ".tsx", ".mjs"],
  "reporter": [
    "text",
    "lcov",
    "json-summary"
  ],
  "reports-dir": ".coverage-reports/typescript"
}
